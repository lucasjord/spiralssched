$EXPER;
*
def v255az;
     exper_name = v255az;
     exper_description = "Extraordinary Maser Flaring in High Mass Star Forming Region NGC6334I";
     PI_name = "Jayender Kumar";
     PI_email = jayender.kumar@csiro.au;
*    address:   CSIRO Space and Astronomy
*               26 Pembroke Rd
*               Marsfield
*               NSW AUS 2022
*    phone:     +61-4-02008533
*    during obs:+61-4-02008533
*    fax:       +61-4-02008533
*    Please see wiki for notes on experiment
*
*    year, doy: 2025, 351
*    date     : Wed 17 Dec 2025
*    MJD      : 61026
     exper_nominal_start=2025y351d21h00m00s;
     exper_nominal_stop=2025y352d05h02m00s;
*
     target_correlator = LBA;
*
*    integr_time    : 2.0 s
*    number_channels: 16384
*    number_antenna : 6
*    cross_polarize : No
*    weight_func    : UNIFORM
*    distrib_medium : DAT
*    distrib_format : FITS
*    source_pos_cat : FROM SCHEDULE
*    distribute_to  :
*                     Jayender Kumar
*                     CSIRO Space and Astronomy
*                     26 Pembroke Rd NSW AUS 2022
*                     
*    Details will be discussed before correlation.
*    F* and fringe finders, NGC* are targets, B1950 names are ICRF sources.
*
enddef;
*------------------------------------------------------------------------------
$MODE;
*
def v255az.4cm;
     ref $PROCEDURES = Procedure:Cd:Ho:Wa:Ke:Yg:Mp;
     ref $IF = LO@4500MHzDPolNoTone:Mp;
     ref $IF = LO@5843MHzDPolNoTone:Wa;
     ref $IF = LO@6000MHzDPolNoTone:Ke:Yg;
     ref $IF = LO@7000MHzDPolNoTone:Ho;
     ref $IF = LO@7300MHzDPolNoTone:Cd;
     ref $BBC = 2BBCs:Cd;
     ref $BBC = 2BBCs#02:Ho;
     ref $BBC = 2BBCs#03:Ke:Yg;
     ref $BBC = 2BBCs#04:Mp;
     ref $BBC = 2BBCs#05:Wa;
     ref $PHASE_CAL_DETECT = NoDetect:Cd:Ho:Ke:Mp:Wa:Yg;
     ref $FREQ = 6660MHz2x16MHz:Cd:Ho:Wa;
     ref $FREQ = 6660MHz2x16MHz#02:Ke:Yg;
     ref $FREQ = 6660MHz2x16MHz#03:Mp;
     ref $TRACKS = VDIF5032.2Ch2bit1to1:Cd:Ho:Ke:Mp:Wa:Yg;
     ref $ROLL = NoRoll:Cd:Ho:Ke:Mp:Wa:Yg;
enddef;
*------------------------------------------------------------------------------
$IF;
*
def LO@4500MHzDPolNoTone;
* v255az.4cm: Mp
     if_def = &IF_2N : 2N : R :   4500.00 MHz : U;
     if_def = &IF_1N : 1N : L :   4500.00 MHz : U;
enddef;
*
def LO@5843MHzDPolNoTone;
* v255az.4cm: Wa
     if_def = &IF_A1 : A1 : R :   5843.00 MHz : U;
     if_def = &IF_B2 : B2 : L :   5843.00 MHz : U;
enddef;
*
def LO@6000MHzDPolNoTone;
* v255az.4cm: Ke, Yg
     if_def = &IF_E1 : E1 : R :   6000.00 MHz : U;
     if_def = &IF_F1 : F1 : L :   6000.00 MHz : U;
enddef;
*
def LO@7000MHzDPolNoTone;
* v255az.4cm: Ho
     if_def = &IF_A3 : A3 : R :   7000.00 MHz : L;
     if_def = &IF_B3 : B3 : L :   7000.00 MHz : L;
enddef;
*
def LO@7300MHzDPolNoTone;
* v255az.4cm: Cd
     if_def = &IF_A1 : A1 : R :   7300.00 MHz : L;
     if_def = &IF_B1 : B1 : L :   7300.00 MHz : L;
enddef;
*------------------------------------------------------------------------------
$BBC;
*
def 2BBCs;
* v255az.4cm: Cd
     BBC_assign = &BBC01 : 1 : &IF_A1;
     BBC_assign = &BBC05 : 5 : &IF_B1;
enddef;
*
def 2BBCs#02;
* v255az.4cm: Ho
     BBC_assign = &BBC01 : 1 : &IF_A3;
     BBC_assign = &BBC05 : 5 : &IF_B3;
enddef;
*
def 2BBCs#03;
* v255az.4cm: Ke, Yg
     BBC_assign = &BBC33 : 33 : &IF_E1;
     BBC_assign = &BBC41 : 41 : &IF_F1;
enddef;
*
def 2BBCs#04;
* v255az.4cm: Mp
     BBC_assign = &BBC01 : 1 : &IF_2N;
     BBC_assign = &BBC02 : 2 : &IF_1N;
enddef;
*
def 2BBCs#05;
* v255az.4cm: Wa
     BBC_assign = &BBC01 : 1 : &IF_A1;
     BBC_assign = &BBC05 : 5 : &IF_B2;
enddef;
*------------------------------------------------------------------------------
$PHASE_CAL_DETECT;
*
def NoDetect;
* v255az.4cm: Cd, Ho, Ke, Mp, Wa, Yg
     phase_cal_detect = &NoCal;
enddef;
*------------------------------------------------------------------------------
$FREQ;
*
def 6660MHz2x16MHz;
* v255az.4cm: Cd, Ho, Wa
     chan_def =  : 6660 MHz : U :   16.00 MHz : &CH01 : &BBC01 : &NoCal; * RCP
     chan_def =  : 6660 MHz : U :   16.00 MHz : &CH02 : &BBC05 : &NoCal; * LCP
     sample_rate =  32.000 Ms/sec;
enddef;
*
def 6660MHz2x16MHz#02;
* v255az.4cm: Ke, Yg
     chan_def =  : 6660 MHz : U :   16.00 MHz : &CH01 : &BBC33 : &NoCal; * RCP
     chan_def =  : 6660 MHz : U :   16.00 MHz : &CH02 : &BBC41 : &NoCal; * LCP
     sample_rate =  32.000 Ms/sec;
enddef;
*
def 6660MHz2x16MHz#03;
* v255az.4cm: Mp
     chan_def =  : 6660 MHz : U :   16.00 MHz : &CH01 : &BBC01 : &NoCal; * RCP
     chan_def =  : 6660 MHz : U :   16.00 MHz : &CH02 : &BBC02 : &NoCal; * LCP
     sample_rate =  32.000 Ms/sec;
enddef;
*------------------------------------------------------------------------------
$TRACKS;
*
def VDIF5032.2Ch2bit1to1;
* v255az.4cm: Cd, Ho, Ke, Mp, Wa, Yg
     track_frame_format = VDIF5032;
     fanout_def =  : &CH01 : sign : 1 : 1;
     fanout_def =  : &CH01 :  mag : 1 : 1;
     fanout_def =  : &CH02 : sign : 1 : 2;
     fanout_def =  : &CH02 :  mag : 1 : 2;
enddef;
*------------------------------------------------------------------------------
$ROLL;
*
def NoRoll;
* v255az.4cm: Cd, Ho, Ke, Mp, Wa, Yg
     roll = off;
enddef;
