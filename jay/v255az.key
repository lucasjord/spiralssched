! ==========================================================
! =================  Cover Information  ====================
! ==========================================================
! Initial version
version  = 1.0
expt     = 'Extraordinary Maser Flaring in High Mass Star Forming Region NGC6334I'
expcode  = 'v255az'
obstype  = 'VLBI'
piname   = 'Jayender Kumar'
address1 = 'CSIRO Space and Astronomy'
address2 = '26 Pembroke Rd'
address3 = 'Marsfield'
address4 = 'NSW AUS 2022'
phone    = '+61-4-02008533'
obsphone = '+61-4-02008533'
email    = 'jayender.kumar@csiro.au'
fax      = '+61-4-02008533'
obsmode  = 'LBA5cm-2p-1IF/16/disk'
note1     = 'Please see wiki for notes on experiment'

! ==========================================================
! ==============  Correlator Information  ==================
! ==========================================================
correl   = 'LBA'
coravg   = 2
corchan  = 16384
cornant  = 6
corpol   = 'off'
corwtfn  = 'uniform'
corsrcs  = 'from schedule'
cortape  = 'DAT'
corship1 = 'Jayender Kumar'
corship2 = 'CSIRO Space and Astronomy'
corship3 = '26 Pembroke Rd NSW AUS 2022'
cornote1 = 'Details will be discussed before correlation.'
cornote2 = 'F* and fringe finders, NGC* are targets, B1950 names are ICRF sources.'

! ==========================================================
! ==================  Program control  =====================
! ==========================================================

! Allow SCHED to overwrite existing files

overwrit

! Print start and end elevation, time on source and slew time
! in summary file

sumitem  = el1, el2, dwell, slew


! Catalog files

freqfile = ./freq.spirals.dat
stafile  = ./stations.spirals.dat
locfile  = ./locations.spirals.dat

! ==========================================================
! ===================  Source Catalog  =====================
! ==========================================================

srccat/

! My sources:
!SOURCE='NGC6334F'   RA=17:20:53.454      DEC=-35:47:00.52     EQUINOX='J2000' VEL=-11 //
SOURCE='NGC6334I'  RA=17:20:53.454      DEC=-35:47:00.52     EQUINOX='J2000' VEL=-11, -11 //

SOURCE='J1729-373'  RA=17:33:15.192721   DEC=-37:22:32.39565  EQUINOX='J2000'  //    ! separation 2.95 degrees
SOURCE='J1723-3639'  RA=17:23:50.447      DEC=-36:38:57.44     EQUINOX='J2000' //
SOURCE='J1726-3608'  RA=17:26:43.616      DEC=-36:09:16.41     EQUINOX='J2000' //

!===========================================================================================

