!=======================================================
! Fringe finder

endcat /
! ==========================================================
! ====================  Line Information ====================
! ==========================================================

! define rest frequencies of the line to be observed

lineinit /
lineset = 'ch3oh' restfreq = 6668.5192 /
endlines /

! choose this line for Doppler tracking
!linename = 'ch3oh' doppler

!123456789012345678901234567890123456789012345678901234567890
! ==========================================================
! ==================== Setup Information ===================
! ==========================================================

! Get frequency information from the DEFAULT catalog

setinit=v255az.4cm /
       station = CEDUNA,WARK30M  ! change names back to CDDBBC
       pcal='off'
       nchan = 2
       bits  = 2
       bbfilter = 16.0
       netside  = U
       pol      = R,L
       freqref  = 6660
       freqoff  = 0
       bbc      =  1
       format   = VDIF 
       bbc      =  1, 5 /

       station = HOBART26  ! change to HOB_DBBC
       bbc      =  1, 9 /

       station = KATH12M, YARRA12M   ! names 
       bbc      = 33,41 /  ! either 1,2 or 1,5

       station = MOPRA   ! this should be fine
       bbc      = 1,2 /
endset /


! ==========================================================
! =================  Initial Scan Information  =============
! ==========================================================

!year  = 2025
!month = 12
!day   = 17
!start = 21:00:00
!!Hobart Local time is 08:00:00
!!Hobart LST is round 12:20:00
!
!station = CDDBBC, HOB_DBBC, MOPRA, WARK30M, KATHERIN, YARRAGAD
!setup   = v255az.4cm


